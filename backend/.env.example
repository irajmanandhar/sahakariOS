APP_NAME=SahakariOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Browser-facing origin (Next.js BFF). Reset-password links point here.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development only. These values must match docker-compose.yml.
# Never put real/production credentials in this file.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sahakarios
DB_USERNAME=sahakarios
DB_PASSWORD=local_dev_only

# Session cookie: HttpOnly (Laravel default), SameSite=lax, host-only (no domain).
# Production over HTTPS: SESSION_SECURE_COOKIE=true; consider SESSION_COOKIE=__Host-sahakarios_session.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Empty = trust no X-Forwarded-For header. Keep empty unless an edge proxy you
# control OVERWRITES X-Forwarded-For: the Next.js proxy forwards a client-supplied
# header unchanged, so trusting it would let clients fake their IP and dodge
# login throttling. See docs/authentication.md.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Redis: login/password-reset rate limits must be shared by all app servers.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local only: the log mailer writes whole emails, including password-reset links,
# to storage/logs. Production must use a real mailer (e.g. smtp) and never 'log'.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
